{
  "name": "forge-mcp-detonator",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-based static and runtime analysis for local MCP servers",
  "type": "module",
  "bin": {
    "forge": "./dist/cli.js"
  },
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "verify:e2e": "npm run build && node scripts/verify-e2e.mjs",
    "verify:agent": "npm run build && node scripts/verify-agent-v1.mjs",
    "verify:publisher": "npm run build && node scripts/verify-publisher.mjs",
    "experiment:v2-proposals": "tsx scripts/run-v2-agent-proposals.ts",
    "experiment:v2-proposal-study": "node --env-file-if-exists=.env --import tsx scripts/run-v2-agent-proposal-study.ts",
    "test:watch": "vitest",
    "typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1121.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "ajv": "8.20.0",
    "commander": "15.0.0",
    "pg": "8.23.0",
    "semver": "7.8.5",
    "typescript-semantic": "npm:typescript@6.0.3",
    "yaml": "2.9.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/pg": "8.23.1",
    "@types/semver": "7.8.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
